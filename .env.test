# Minimal environment for testing
NODE_ENV=development
DATABASE_URL=postgresql://localhost:5432/test_db
MAX_MONTHLY_TASKS=50
SESSION_SECRET=test-secret-for-development

# These would normally be set with real values
GITHUB_CLIENT_ID=test_client_id
GITHUB_CLIENT_SECRET=test_client_secret
GITHUB_WEBHOOK_SECRET=test_webhook_secret
GITHUB_TOKEN=test_token

# Mock VAPID keys for push notifications
VAPID_PUBLIC_KEY=test_public_key
VAPID_PRIVATE_KEY=test_private_key
VAPID_SUBJECT=mailto:test@example.com